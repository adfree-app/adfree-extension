{
  "manifest_version": 3,
  "name": "AdFree page runtime",
  "short_name": "AdFree",
  "description": "Asks the AdFree app what to inject, and applies it — for pages a service worker served from its cache.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AdFree",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"]
}
